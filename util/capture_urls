#!/usr/bin/python
"""Sequentially capture a bounded list of URLs with progress recorded as JSONL."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys
import time

from epitome_lib.capture import (
    archival_url_key,
    capture_url,
    completed_capture_urls,
    recommended_page_delay,
    url_slug,
    validate_url,
)


def load_urls(positional: list[str], url_file: Path | None) -> list[str]:
    values = list(positional)
    if url_file:
        values.extend(
            line.strip()
            for line in url_file.read_text(encoding="utf-8").splitlines()
            if line.strip() and not line.lstrip().startswith("#")
        )
    seen: set[str] = set()
    result = []
    for value in values:
        validate_url(value)
        if value not in seen:
            seen.add(value)
            result.append(value)
    return result


def append_event(path: Path, event: dict) -> None:
    with path.open("a", encoding="utf-8") as stream:
        stream.write(json.dumps(event, ensure_ascii=False, sort_keys=True) + "\n")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("urls", nargs="*")
    parser.add_argument("--url-file", type=Path)
    parser.add_argument("--output-root", type=Path)
    parser.add_argument(
        "--existing-root",
        action="append",
        type=Path,
        help="skip completed captures below this root (repeatable; default: data)",
    )
    parser.add_argument(
        "--allow-recapture",
        action="store_true",
        help="capture URLs even when a complete archived copy already exists",
    )
    parser.add_argument(
        "--max-urls",
        type=int,
        default=10,
        help="refuse larger inputs unless this limit is explicitly raised",
    )
    parser.add_argument("--port", type=int, default=2103)
    parser.add_argument("--max-scrolls", type=int, default=40)
    parser.add_argument("--max-seconds", type=float, default=90)
    parser.add_argument("--settle-seconds", type=float, default=2)
    parser.add_argument("--no-complete-assets", action="store_true")
    parser.add_argument("--max-assets", type=int, default=50)
    parser.add_argument("--max-asset-bytes", type=int, default=500 * 1024 * 1024)
    parser.add_argument("--asset-delay-seconds", type=float, default=2)
    parser.add_argument("--asset-timeout", type=float, default=90)
    parser.add_argument(
        "--exclude-asset-host",
        action="append",
        default=[],
        help="skip asset-completion downloads from this exact host (repeatable)",
    )
    parser.add_argument(
        "--delay-seconds",
        type=float,
        help="pause between pages (default: 10-45 seconds based on batch size)",
    )
    parser.add_argument("--stop-on-error", action="store_true")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    try:
        urls = load_urls(args.urls, args.url_file)
    except (OSError, ValueError) as error:
        print(f"capture_urls: {error}", file=sys.stderr)
        return 2
    if not urls:
        print("capture_urls: no URLs supplied", file=sys.stderr)
        return 2
    existing_roots = args.existing_root or [Path("data")]
    skipped_existing = []
    if not args.allow_recapture:
        completed = completed_capture_urls(existing_roots)
        skipped_existing = [
            url for url in urls if archival_url_key(url) in completed
        ]
        urls = [
            url for url in urls if archival_url_key(url) not in completed
        ]
        if skipped_existing:
            print(
                f"Skipping {len(skipped_existing)} already completed URL(s)",
                flush=True,
            )
    if not urls:
        print("capture_urls: every supplied URL already has a complete capture")
        return 0
    if args.max_urls < 1:
        print("capture_urls: --max-urls must be positive", file=sys.stderr)
        return 2
    delay_seconds = (
        args.delay_seconds
        if args.delay_seconds is not None
        else recommended_page_delay(len(urls))
    )
    if delay_seconds < 0:
        print("capture_urls: --delay-seconds must be non-negative", file=sys.stderr)
        return 2
    if len(urls) > args.max_urls:
        print(
            f"capture_urls: refusing {len(urls)} URLs; "
            f"raise --max-urls from {args.max_urls} explicitly",
            file=sys.stderr,
        )
        return 2

    run_timestamp = int(time.time())
    root = args.output_root or Path("data/crawls") / str(run_timestamp)
    pages = root / "pages"
    pages.mkdir(parents=True, exist_ok=False)
    progress = root / "progress.jsonl"
    failures = 0
    append_event(
        progress,
        {
            "delay_seconds": delay_seconds,
            "event": "start",
            "skipped_existing": skipped_existing,
            "timestamp": run_timestamp,
            "urls": urls,
        },
    )
    for index, url in enumerate(urls, start=1):
        output = pages / f"{index:06d}-{url_slug(url)}"
        append_event(
            progress,
            {"event": "capture_start", "index": index, "url": url},
        )
        print(f"[{index}/{len(urls)}] Capturing {url}", flush=True)
        try:
            manifest = capture_url(
                url,
                output,
                port=args.port,
                max_scrolls=args.max_scrolls,
                max_seconds=args.max_seconds,
                settle_seconds=args.settle_seconds,
                complete_assets=not args.no_complete_assets,
                max_assets=args.max_assets,
                max_asset_bytes=args.max_asset_bytes,
                asset_delay_seconds=args.asset_delay_seconds,
                asset_timeout=args.asset_timeout,
                exclude_asset_hosts=set(args.exclude_asset_host),
            )
            append_event(
                progress,
                {
                    "event": "capture_complete",
                    "index": index,
                    "url": url,
                    "network_summary": manifest["network_summary"],
                },
            )
        except Exception as error:
            failures += 1
            append_event(
                progress,
                {
                    "event": "capture_error",
                    "index": index,
                    "url": url,
                    "error": f"{type(error).__name__}: {error}",
                },
            )
            print(f"capture_urls: {url}: {error}", file=sys.stderr)
            if args.stop_on_error:
                break
        if index < len(urls) and delay_seconds:
            append_event(
                progress,
                {
                    "event": "delay",
                    "after_index": index,
                    "seconds": delay_seconds,
                },
            )
            print(
                f"Waiting {delay_seconds:g} seconds before the next article",
                flush=True,
            )
            time.sleep(delay_seconds)
    append_event(
        progress,
        {"event": "finish", "timestamp": int(time.time()), "failures": failures},
    )
    print(f"Capture run written to {root} ({failures} failures)")
    return min(failures, 1)


if __name__ == "__main__":
    raise SystemExit(main())
