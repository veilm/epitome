#!/usr/bin/python
"""Create a tracked import inventory for media embedded in captures."""

from __future__ import annotations

import argparse
from pathlib import Path

from epitome_lib.media_inventory import write_youtube_inventory


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("capture_roots", nargs="+", type=Path)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--source", required=True)
    parser.add_argument("--media-root", default="media/youtube")
    parser.add_argument("--generated-at", type=int)
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    data = write_youtube_inventory(
        args.capture_roots,
        args.output,
        source=args.source,
        media_root=args.media_root,
        generated_at_unix=args.generated_at,
    )
    summary = data["summary"]
    print(
        f"Wrote {summary['videos']} videos across {summary['articles']} articles "
        f"to {args.output}"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
