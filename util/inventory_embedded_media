#!/usr/bin/python
"""Create a tracked import inventory for media embedded in captures."""

from __future__ import annotations

import argparse
from pathlib import Path

from epitome_lib.media_inventory import (
    write_substack_audio_inventory,
    write_substack_video_inventory,
    write_youtube_inventory,
)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("capture_roots", nargs="+", type=Path)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--source", required=True)
    parser.add_argument("--media-root")
    parser.add_argument("--generated-at", type=int)
    parser.add_argument(
        "--provider",
        choices=("youtube", "substack", "substack-audio"),
        default="youtube",
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    writers = {
        "youtube": (write_youtube_inventory, "media/youtube"),
        "substack": (write_substack_video_inventory, "media/substack"),
        "substack-audio": (write_substack_audio_inventory, "media/substack-audio"),
    }
    writer, default_media_root = writers[args.provider]
    data = writer(
        args.capture_roots,
        args.output,
        source=args.source,
        media_root=args.media_root or default_media_root,
        generated_at_unix=args.generated_at,
    )
    summary = data["summary"]
    count = summary.get("videos", summary.get("audios", 0))
    noun = "audio items" if "audios" in summary else "videos"
    print(f"Wrote {count} {noun} across {summary['articles']} articles to {args.output}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
